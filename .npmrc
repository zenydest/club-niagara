# Hositar paquetes necesarios para el build de Android con pnpm.
# @react-native/gradle-plugin y expo-modules-autolinking son dependencias
# transitivas que el Gradle de React Native necesita encontrar en node_modules/
# como directorios reales (no solo en .pnpm/).
public-hoist-pattern[]=@react-native/gradle-plugin
public-hoist-pattern[]=expo-modules-autolinking

node-linker=hoisted
