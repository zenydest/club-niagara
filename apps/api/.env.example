# ============================================================
# API Club Niágara — variables de entorno
# Copiar a apps/api/.env y completar.
# ============================================================

# ── Base de datos ────────────────────────────────────────────
# Postgres de Render (usar la Internal URL en producción)
DATABASE_URL="postgresql://usuario:password@host:5432/club_niagara"

# ── Better Auth ──────────────────────────────────────────────
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Dominio público de la API
BETTER_AUTH_URL="http://localhost:3001"

# ── CORS ─────────────────────────────────────────────────────
# Dominios del front separados por coma. Sin esto, la web no puede
# hablarle a la API (CORS + cookies cross-site dependen de esta lista).
FRONTEND_URLS="http://localhost:5173,http://localhost:5174"

# ── Servidor ─────────────────────────────────────────────────
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"

# ── Mercado Pago ─────────────────────────────────────────────
# Access token de la aplicación creada en "Tus integraciones".
# Con el token de prueba empieza con TEST-, en producción con APP_USR-.
# Sin esta variable, las terminales Point no se pueden operar.
MP_ACCESS_TOKEN=""

# Secreto del webhook, en el panel de MP → Webhooks → "Clave secreta".
# Sin esto el webhook de pagos acepta cualquier origen: alguien podría
# marcar cobros como aprobados sin haber pagado. Configurarlo siempre
# antes de salir a producción.
MP_WEBHOOK_SECRET=""

# ── Cloudinary (portadas de eventos) ─────────────────────────
# Forma recomendada: copiar la línea que da el panel de Cloudinary en
# Settings → API Keys. Viene armada de una pieza, así que no hay forma de
# mezclar la key de una credencial con el secret de otra.
#
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#
# Sin esto el panel sigue andando: la pestaña "Subir archivo" queda desactivada
# y se puede pegar la URL de una imagen ya publicada.
#
# El API secret NO va nunca al frontend: la API firma el pedido y el navegador
# sube directo a Cloudinary.
CLOUDINARY_URL=""

# Alternativa, si preferís tenerlas separadas. Solo se usan si no hay
# CLOUDINARY_URL.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
