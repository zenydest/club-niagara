# ============================================================
# Club Niágara — Variables de entorno
# Copiá este archivo a .env en cada app y completá los valores
# ============================================================

# ─── Base de datos (Render PostgreSQL) ──────────────────────
# Obtener desde: Render dashboard → tu PostgreSQL → Connection String
DATABASE_URL="postgresql://usuario:password@host.render.com:5432/club_niagara?sslmode=require"

# ─── Better Auth ─────────────────────────────────────────────
# Generá un secret seguro: openssl rand -base64 32
BETTER_AUTH_SECRET="cambiar-por-un-secret-seguro-minimo-32-chars"
# URL pública del backend API (en prod: tu URL de Render)
BETTER_AUTH_URL="http://localhost:3001"

# ─── API Server (apps/api) ───────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# URLs del frontend separadas por coma (para CORS)
FRONTEND_URLS="http://localhost:5173,http://localhost:5174"

# ─── Apps frontend (apps/web y apps/pos) ────────────────────
# IMPORTANTE: en Vite, las variables deben tener prefijo VITE_
VITE_API_URL="http://localhost:3001"
