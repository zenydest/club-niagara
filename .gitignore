# Dependencias
node_modules/
.pnpm-store/

# Este repo usa pnpm. Un package-lock.json o yarn.lock sueltos hacen que las
# plataformas de build detecten el gestor equivocado: EAS eligió npm por un
# package-lock.json de la raíz, npm ignora pnpm-workspace.yaml, y terminó
# instalando solo las dos dependencias del root. El build fallaba con
# "The expo package was not found".
package-lock.json
yarn.lock

# Build outputs
dist/
build/
.turbo/

# Electron builds
out/
release/

# Variables de entorno (NUNCA subir)
.env
.env.local
.env.*.local

# Prisma
packages/db/prisma/dev.db
packages/db/prisma/migrations/

# Expo — estado local del dispositivo y del dev server
.expo/

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
